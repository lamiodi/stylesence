generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         String         @default("OWNER")
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id         String    @id @default(cuid())
  token      String    @unique
  adminUserId String
  adminUser  AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  tagline  String?
  imageUrl String?
  position Int       @default(0)
  products Product[]
}

model Product {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  subtitle       String?
  description    String          @default("")
  details        String?
  material       String?
  care           String?
  price          Int
  compareAtPrice Int?
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  isActive       Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  images         ProductImage[]
  variants       ProductVariant[]
  reviews        Review[]
  curatedRelations ProductRelation[] @relation("CuratedRelations")
  curatedRelated   ProductRelation[] @relation("CuratedRelated")
}

model ProductRelation {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation("CuratedRelations", fields: [productId], references: [id], onDelete: Cascade)
  relatedId  String
  related    Product @relation("CuratedRelated", fields: [relatedId], references: [id], onDelete: Cascade)
  position   Int     @default(0)
  createdAt  DateTime @default(now())

  @@unique([productId, relatedId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  color      String
  colorHex   String      @default("#EDE7DC")
  sku        String      @unique
  stock      Int         @default(0)
  cartItems  CartItem[]
  stockAlerts StockAlert[]
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  email     String?
  rating    Int
  title     String?
  body      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  cookieId  String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int             @default(1)

  @@unique([cartId, variantId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  email         String
  fullName      String
  phone         String?
  address       String
  city          String
  state         String
  country       String      @default("Nigeria")
  notes         String?
  shippingMethod String     @default("standard")
  shipping      Int         @default(0)
  subtotal      Int
  discount      Int         @default(0)
  promoCode     String?
  total         Int
  status        String      @default("PAID")
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  productName String
  productSlug String
  size        String
  color       String
  imageUrl    String?
  unitPrice   Int
  qty         Int
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())
}

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  label       String?
  type        String    @default("PERCENT") // PERCENT | AMOUNT | SHIPPING
  value       Int       @default(0) // percent points (PERCENT) or Naira (AMOUNT); ignored for SHIPPING
  minSubtotal Int       @default(0)
  maxUsage    Int? // null = unlimited
  usageCount  Int       @default(0)
  /** One redemption per customer email (checked against past orders at checkout). */
  singleUsePerCustomer Boolean @default(false)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Customer {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String
  passwordHash   String
  phone          String?
  defaultAddress String?
  defaultCity    String?
  defaultState   String?
  /** Single-use password-reset token (hashed) — set by the reset request flow. */
  resetTokenHash String?
  resetTokenAt   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sessions       CustomerSession[]
  wishlistItems  WishlistItem[]
}

model CustomerSession {
  id         String   @id @default(cuid())
  token      String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  slug       String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([customerId, slug])
}

model JournalPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  body        String
  category    String   @default("Journal")
  coverImage  String?
  readTime    Int      @default(4)
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
}

/** Back-in-stock waitlist entry — one per (variant, email). Simulated notify on restock. */
model StockAlert {
  id         String    @id @default(cuid())
  email      String
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /** Set when an admin restock (0 → >0) triggers the (simulated) notification email. */
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([variantId, email])
}
